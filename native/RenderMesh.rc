    BEGIN
      VALUE "CompanyName", "RenderMesh"
      VALUE "FileDescription", "RenderMesh Blender 分布式渲染农场"
      VALUE "FileVersion", "0.2.8"
      VALUE "InternalName", "RenderMesh.exe"
      VALUE "OriginalFilename", "RenderMesh.exe"
      VALUE "ProductName", "RenderMesh"
      VALUE "ProductVersion", "0.2.8"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
